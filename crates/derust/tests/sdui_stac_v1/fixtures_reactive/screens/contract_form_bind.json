{
  "type": "form",
  "state": { "name": "", "accepted": false, "saved": false },
  "child": {
    "type": "column",
    "children": [
      { "type": "textField", "bind": "name" },
      { "type": "checkBox", "bind": "accepted" },
      { "type": "text", "data": "Name is too short", "visible": { "$expr": "length(trim(name)) < 3" } },
      {
        "type": "elevatedButton",
        "enabled": { "$expr": "accepted && length(trim(name)) >= 3" },
        "child": { "type": "text", "data": "Save" },
        "onPressed": {
          "actionType": "setState",
          "condition": { "$expr": "!saved" },
          "values": { "saved": true }
        }
      },
      { "type": "text", "data": "Saved", "visible": { "$state": "saved" } }
    ]
  }
}
