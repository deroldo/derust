{
  "color": "#FF0000",
  "image": {
    "src": "sample",
    "fit": "fill",
    "imageType": "file",
    "alignment": "topLeft",
    "centerSlice": {
      "rectType": "fromCenter"
    },
    "repeat": "repeat",
    "matchTextDirection": true,
    "scale": 1.5,
    "opacity": 1.5,
    "filterQuality": "none",
    "invertColors": true,
    "isAntiAlias": true
  },
  "border": {
    "color": "#FF0000",
    "borderStyle": "none",
    "width": 1.5,
    "strokeAlign": 1.5,
    "top": {},
    "right": {},
    "bottom": {},
    "left": {}
  },
  "borderRadius": {
    "topLeft": 1.5,
    "topRight": 1.5,
    "bottomLeft": 1.5,
    "bottomRight": 1.5
  },
  "boxShadow": [
    {
      "color": "#FF0000",
