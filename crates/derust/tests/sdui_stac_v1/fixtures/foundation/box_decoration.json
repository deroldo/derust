  "gradient": {
    "gradientType": "linear",
    "colors": [
      "#FF0000"
    ],
    "stops": [
      1.5
    ],
    "begin": "topLeft",
    "end": "topLeft",
    "center": "topLeft",
    "focal": "topLeft",
    "tileMode": "clamp",
    "focalRadius": 1.5,
    "radius": 1.5,
    "startAngle": 1.5,
    "endAngle": 1.5
  },
  "backgroundBlendMode": "clear",
  "shape": "rectangle"
